# ============================================
# Frontend Production Environment for Vercel
# ============================================
# Save as: .env.production in frontend directory
# Or add these as environment variables in Vercel dashboard

# API Configuration
VITE_API_URL=https://your-railway-app.railway.app
VITE_API_BASE_PATH=/api

# Replace 'your-railway-app' with your actual Railway app URL
# Example: VITE_API_URL=https://ccs-backend-production.railway.app
